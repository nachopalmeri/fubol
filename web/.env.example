# Copiar a .env (o definir en docker compose) y completar. No commitear secretos.
# Password del panel. Si queda vacía, se genera en data/admin-password.txt.
FUBOL_ADMIN_PASSWORD=
# HMAC de cookies/tokens. Si queda vacío, se genera en data/secret.key (mín. 32 chars).
FUBOL_SECRET=
# URL pública para armar links. Ej: https://fubol.example.com
FUBOL_BASE_URL=
# 1 solo si tus fuentes HLS/M3U viven en la LAN (10.x, 192.168.x, 172.16-31.x).
FUBOL_ALLOW_PRIVATE_SOURCES=0
# 1 solo para HTTP en LAN confiable; en HTTPS dejar 0.
FUBOL_INSECURE_COOKIES=0
FUBOL_INCLUDE_INTERNATIONAL=1
# Calendarios ICS separados por coma.
FUBOL_ICS_URLS=
FUBOL_NO_DEFAULT_ADDONS=0
FUBOL_LOG_LEVEL=info
# TheSportsDB usa la key pública 123 para pruebas; pedir una propia si hay límite.
SPORTSDB_KEY=123
OPENSUBTITLES_API_KEY=
# Sidecar ffsubsync opcional, ej: http://127.0.0.1:8080
SUBSYNC_URL=
TZ=America/Argentina/Buenos_Aires
