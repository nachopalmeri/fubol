# Referencia de variables. NO hace falta completar a mano:
# `bash setup.sh` genera .env (y config/mediafusion.env) con valores aleatorios.
#
# SERVER_HOST: IP LAN o hostname que usan tus dispositivos (TV, PC, celular).
#   Ejemplos: 192.168.1.50 | streaming-vm.local
SERVER_HOST=

# --- AIOStreams ---
SECRET_KEY=                 # 64 hex (openssl rand -hex 32)
AIOSTREAMS_AUTH=            # usuario:password -> protege el panel (ej: admin:...)

# --- MediaFusion (perfil sports) ---
SECRET_KEY_MF=              # 32 hex, separada de SECRET_KEY (SEC-04)
API_PASSWORD=               # password del panel de MediaFusion
MEDIAFUSION_DB_PASSWORD=    # password de PostgreSQL
CONTACT_EMAIL=admin@example.com

# --- MediaFlow (perfil sports, proxy interno) ---
MEDIAFLOW_API_PASSWORD=

# --- DNS (perfil dns) ---
PIHOLE_WEBPASSWORD=         # admin de Pi-hole

# --- General ---
TZ=America/Argentina/Buenos_Aires
